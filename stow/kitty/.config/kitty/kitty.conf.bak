#
#  Beautiful terminal configuration for Kitty
# ──────────────────────────────────────────────────────────────────────────────

# ── Typography ────────────────────────────────────────────────────────────────

font_family      CaskaydiaCove Nerd Font
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        12.0

# Precise line height for premium readability
modify_font underline_position -2
modify_font underline_thickness 150%
modify_font strikethrough_position 2px

# Modern Font Features
disable_ligatures cursor
font_features CaskaydiaCoveNF-Italic +ss01 +ss02 +ss03 +ss04 +ss05 +zero
render_full_width_glyphs yes

# ── Window Aesthetics ─────────────────────────────────────────────────────────

# Spacing & Layout
window_padding_width  20
window_padding_height 20
placement_strategy    center

# Decor & Borders
hide_window_decorations yes
draw_minimal_borders    yes
window_border_width     1pt
window_margin_width     0
confirm_os_window_close 0

# ── Tab Bar (Premium Floating) ───────────────────────────────────────────────

tab_bar_edge            top
tab_bar_margin_width    15
tab_bar_margin_height   15 5
tab_bar_style           powerline
tab_powerline_style     round
tab_title_template      " 󰄬 {index} {title} "
active_tab_font_style   bold
inactive_tab_font_style normal

# ── Cursor & Interaction ─────────────────────────────────────────────────────

# Cursor Aesthetics
cursor_shape            beam
cursor_blink_interval   0
cursor_stop_blinking_after 15.0

# Modern UX: Cursor Trail
cursor_trail            1
cursor_trail_decay      0.1 0.4
cursor_trail_start_threshold 2

# Interaction Settings
url_style               curly
detect_urls             yes
copy_on_select          yes
mouse_hide_wait         3.0
strip_trailing_spaces   smart
focus_follows_mouse     yes

# ── Keybindings ───────────────────────────────────────────────────────────

map ctrl+insert         copy_to_clipboard
map shift+insert        paste_from_clipboard
map ctrl+shift+enter    new_window_with_cwd
map ctrl+shift+t        new_tab_with_cwd

# ── System Integration ────────────────────────────────────────────────────────

single_instance         yes
allow_remote_control    yes
term                    xterm-kitty

# ── Theme Integration ─────────────────────────────────────────────────────────

# BEGIN_KITTY_THEME
# Noctalia (Loaded from external file)
include current-theme.conf
# END_KITTY_THEME
